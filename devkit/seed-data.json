{
  "$comment": "Declarative demo data for `make seed`. Edit freely: re-running the seed restores every flag to the states below.",
  "organisation": "FlagLens Demo",
  "project": "Demo Shop",
  "environments": [
    "Development",
    "Staging",
    "Production"
  ],
  "tags": [
    {
      "label": "kill-switch",
      "color": "#d9534f",
      "description": "Emergency off switch. Never stale.",
      "is_permanent": true
    },
    {
      "label": "checkout",
      "color": "#3d8bfd",
      "description": "Checkout squad"
    }
  ],
  "flags": [
    {
      "name": "new_checkout",
      "description": "Rewritten single-page checkout. Rolling out: on in Dev and Staging, off in Production.",
      "tags": [
        "checkout"
      ],
      "states": {
        "Development": {
          "enabled": true
        },
        "Staging": {
          "enabled": true
        },
        "Production": {
          "enabled": false
        }
      }
    },
    {
      "name": "banner_text",
      "description": "Text shown in the shop's top banner (remote config).",
      "initial_value": "Welcome!",
      "states": {
        "Development": {
          "enabled": true,
          "value": "🚧 dev build"
        },
        "Staging": {
          "enabled": true,
          "value": "Black Friday: 30% off"
        },
        "Production": {
          "enabled": true,
          "value": "Black Friday: 30% off"
        }
      }
    },
    {
      "name": "rate_limit_per_minute",
      "description": "Requests per minute per customer. Staging and Production should match.",
      "initial_value": 100,
      "states": {
        "Development": {
          "enabled": true,
          "value": 1000
        },
        "Staging": {
          "enabled": true,
          "value": 100
        },
        "Production": {
          "enabled": true,
          "value": 50
        }
      }
    },
    {
      "name": "checkout_button_color",
      "description": "Colour experiment for the checkout button. Control is blue.",
      "type": "MULTIVARIATE",
      "initial_value": "blue",
      "tags": [
        "checkout"
      ],
      "variants": [
        {
          "key": "green",
          "value": "green",
          "weight": 50
        },
        {
          "key": "orange",
          "value": "orange",
          "weight": 50
        }
      ],
      "states": {
        "Development": {
          "enabled": true
        },
        "Staging": {
          "enabled": true
        },
        "Production": {
          "enabled": true
        }
      }
    },
    {
      "name": "dark_mode",
      "description": "Dark theme for the shop. Fully rolled out a while ago.",
      "states": {
        "Development": {
          "enabled": true
        },
        "Staging": {
          "enabled": true
        },
        "Production": {
          "enabled": true
        }
      }
    },
    {
      "name": "maintenance_mode",
      "description": "Shows a maintenance page instead of the shop.",
      "tags": [
        "kill-switch"
      ],
      "states": {
        "Development": {
          "enabled": false
        },
        "Staging": {
          "enabled": false
        },
        "Production": {
          "enabled": false
        }
      }
    },
    {
      "name": "legacy_search",
      "description": "Old search backend. Replaced; archived.",
      "archived": true,
      "states": {
        "Development": {
          "enabled": false
        },
        "Staging": {
          "enabled": false
        },
        "Production": {
          "enabled": false
        }
      }
    }
  ],
  "segments": [
    {
      "name": "beta_testers",
      "description": "Staff and beta testers, matched by email domain.",
      "rules": [
        {
          "type": "ANY",
          "conditions": [
            {
              "property": "email",
              "operator": "REGEX",
              "value": ".*@demo-shop\\.dev$"
            }
          ]
        }
      ]
    },
    {
      "name": "pro_plan",
      "description": "Customers on the Pro plan.",
      "rules": [
        {
          "type": "ALL",
          "conditions": [
            {
              "property": "plan",
              "operator": "EQUAL",
              "value": "pro"
            }
          ]
        }
      ]
    },
    {
      "name": "india",
      "description": "Visitors in India.",
      "rules": [
        {
          "type": "ALL",
          "conditions": [
            {
              "property": "country",
              "operator": "EQUAL",
              "value": "IN"
            }
          ]
        }
      ]
    },
    {
      "name": "pro_eu",
      "description": "Pro customers in the EU. (Deliberate mistake for the rule checker: pro_plan catches them first.)",
      "rules": [
        {
          "type": "ALL",
          "conditions": [
            {
              "property": "plan",
              "operator": "EQUAL",
              "value": "pro"
            },
            {
              "property": "country",
              "operator": "IN",
              "value": "DE,FR,GB"
            }
          ]
        }
      ]
    },
    {
      "name": "uk",
      "description": "Visitors in the UK. (Deliberate mistake for the rule checker: its banner is the same as the default.)",
      "rules": [
        {
          "type": "ALL",
          "conditions": [
            {
              "property": "country",
              "operator": "EQUAL",
              "value": "GB"
            }
          ]
        }
      ]
    },
    {
      "name": "canary_10pct",
      "description": "A stable 10% of identities (percentage split on the identity key).",
      "rules": [
        {
          "type": "ALL",
          "conditions": [
            {
              "property": null,
              "operator": "PERCENTAGE_SPLIT",
              "value": "10"
            }
          ]
        }
      ]
    }
  ],
  "$comment_segment_overrides": "Production only, so Development and Staging behave exactly as before. Listed in priority order (first = highest). The last two are deliberate mistakes that FlagLens: Check Targeting Rules finds.",
  "segment_overrides": [
    {
      "flag": "new_checkout",
      "segment": "beta_testers",
      "environment": "Production",
      "enabled": true
    },
    {
      "flag": "rate_limit_per_minute",
      "segment": "pro_plan",
      "environment": "Production",
      "enabled": true,
      "value": 500
    },
    {
      "flag": "banner_text",
      "segment": "india",
      "environment": "Production",
      "enabled": true,
      "value": "Diwali sale: 40% off"
    },
    {
      "flag": "checkout_button_color",
      "segment": "canary_10pct",
      "environment": "Production",
      "enabled": true,
      "value": "purple"
    },
    {
      "flag": "rate_limit_per_minute",
      "segment": "pro_eu",
      "environment": "Production",
      "enabled": true,
      "value": 800
    },
    {
      "flag": "banner_text",
      "segment": "uk",
      "environment": "Production",
      "enabled": true,
      "value": "Black Friday: 30% off"
    }
  ],
  "$comment_experiment": "Experimentation (beta): an A/B test in Staging. Events are stored in Flagsmith's own database (the self-hosted 'Flagsmith database' warehouse). The seed sends simulated shoppers through Flagsmith's SDK and events APIs: each is assigned a variation by Flagsmith, recorded as an exposure, and converts at the rate below.",
  "experiment": {
    "environment": "Staging",
    "flag": "checkout_button_color",
    "name": "Checkout button colour",
    "hypothesis": "A green checkout button will increase checkout completion by at least 15% within 14 days.",
    "metric": {
      "name": "Checkout completed",
      "description": "A shopper completes checkout",
      "event": "checkout_completed",
      "aggregation": "occurrence",
      "direction": "up"
    },
    "rollout_percentage": 100,
    "split": {
      "green": 33.3,
      "orange": 33.3
    },
    "traffic": {
      "shoppers": 600,
      "conversion_rate": {
        "blue": 0.1,
        "green": 0.14,
        "orange": 0.09
      }
    }
  }
}
