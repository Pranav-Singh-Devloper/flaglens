# FlagLens dev kit configuration.
#
# You normally don't need to create this file by hand: `make seed` writes a working `.env` (git-ignored) for you.
# Copy it to `.env` only if you want to override a default BEFORE seeding, e.g. a different port or admin password.

# Base URL of your Flagsmith instance, without /api/v1. Used by the seed, the demo shop and the extension.
FLAGSMITH_API_URL=http://localhost:8000
# Port 8000 busy? Start the stack with `FLAGSMITH_PORT=8080 make up` (a shell variable read by devkit/compose.yaml)
# and set FLAGSMITH_API_URL=http://localhost:8080 here before `make seed`.

# Organisation API key (SECRET). Written by `make seed`. The extension offers to import it into VS Code SecretStorage.
FLAGSMITH_API_KEY=

# IDs written by `make seed`.
FLAGSMITH_ORGANISATION_ID=
FLAGSMITH_PROJECT_ID=

# Client-side environment keys, written by `make seed`. Public by design; used by the demo shop.
FLAGSMITH_ENV_KEY_DEVELOPMENT=
FLAGSMITH_ENV_KEY_STAGING=
FLAGSMITH_ENV_KEY_PRODUCTION=

# Feature Health webhook of the demo project (SECRET: the URL contains its token). Written by `make seed`;
# `make alert` and `make recover` post to it the way a monitoring tool would.
FLAGSMITH_HEALTH_WEBHOOK_URL=

# Dev-kit admin user (dashboard login). Local only; change before seeding if you like.
ADMIN_EMAIL=admin@flaglens.local
ADMIN_PASSWORD=FlagLens-demo-2026

# Port for the demo shop (`make demo`).
DEMO_PORT=3030

# Which environment the demo shop reads flags from (Development, Staging or Production).
DEMO_ENVIRONMENT=Development
